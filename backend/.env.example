# Server
PORT=3000

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# May be left blank for a passwordless local account (e.g. XAMPP/MariaDB root).
DB_PASSWORD=changeme
DB_NAME=user_management_pro

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1h

# CORS: comma-separated list of allowed browser origins for the admin console.
# Unset or "*" allows any origin (fine for local development).
CORS_ORIGINS=*
